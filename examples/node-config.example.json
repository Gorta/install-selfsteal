{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "VLESS_SELF_STEAL",
      "port": 443,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "dest": "127.0.0.1:9443",
          "xver": 1,
          "spiderX": "/",
          "shortIds": ["REPLACE_WITH_SHORT_ID"],
          "privateKey": "REPLACE_WITH_X25519_PRIVATE_KEY",
          "serverNames": ["your-node-domain.example.com"]
        }
      }
    },
    {
      "tag": "HYSTERIA2_SELF_STEAL",
      "port": 443,
      "listen": "0.0.0.0",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "users": []
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "alpn": ["h3"],
          "certificates": [
            {
              "certificateFile": "/var/lib/remnawave/configs/xray/ssl/fullchain.pem",
              "keyFile": "/var/lib/remnawave/configs/xray/ssl/privkey.key"
            }
          ]
        },
        "hysteriaSettings": {
          "version": 2,
          "udpIdleTimeout": 60,
          "masquerade": {
            "type": "proxy",
            "url": "https://127.0.0.1:9443",
            "rewriteHost": true,
            "insecure": true
          }
        },
        "finalmask": {
          "udp": [
            {
              "type": "salamander",
              "settings": {
                "password": "REPLACE_WITH_SALAMANDER_PASSWORD"
              }
            }
          ],
          "quicParams": {
            "congestion": "bbr",
            "maxIdleTimeout": 90,
            "keepAlivePeriod": 10,
            "disablePathMTUDiscovery": false
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "BLOCK",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "ip": ["geoip:private"],
        "outboundTag": "BLOCK"
      },
      {
        "domain": ["geosite:private"],
        "outboundTag": "BLOCK"
      },
      {
        "protocol": ["bittorrent"],
        "outboundTag": "BLOCK"
      }
    ]
  }
}
